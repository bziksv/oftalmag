				<БитриксКартинка></БитриксКартинка>
				<БитриксКартинкаДетальная></БитриксКартинкаДетальная>
				<ЗначенияСвойств>
					<ЗначенияСвойства>
						<Ид>UF_ICON</Ид>
						<Значение>icon-bag-shop</Значение>
					</ЗначенияСвойства>
