	<Каталог>
		<Ид>enext_catalog</Ид>
		<ИдКлассификатора>enext_catalog</ИдКлассификатора>
		<Наименование>Каталог товаров</Наименование>
		<БитриксКод>enext_catalog</БитриксКод>
		<БитриксСортировка>500</БитриксСортировка>
		<БитриксURLСписок>#SITE_DIR#catalog/</БитриксURLСписок>
		<БитриксURLДеталь>#SITE_DIR#catalog/#SECTION_CODE#/#ELEMENT_CODE#/</БитриксURLДеталь>
		<БитриксURLРаздел>#SITE_DIR#catalog/#SECTION_CODE#/</БитриксURLРаздел>
		<БитриксURLКанонический>http://#SITE_DIR#catalog/#SECTION_CODE#/#ELEMENT_CODE#</БитриксURLКанонический>
		<БитриксКартинка></БитриксКартинка>
		<БитриксИндексироватьЭлементы>true</БитриксИндексироватьЭлементы>
		<БитриксИндексироватьРазделы>true</БитриксИндексироватьРазделы>
		<БитриксДокументооборот>false</БитриксДокументооборот>
		<БитриксПодписи>
			<БитриксПодпись>
				<Ид>ELEMENT_NAME</Ид>
				<Значение>Элемент</Значение>
			</БитриксПодпись>
			<БитриксПодпись>
				<Ид>ELEMENTS_NAME</Ид>
				<Значение>Элементы</Значение>
			</БитриксПодпись>
			<БитриксПодпись>
				<Ид>ELEMENT_ADD</Ид>
				<Значение>Добавить элемент</Значение>
			</БитриксПодпись>
			<БитриксПодпись>
				<Ид>ELEMENT_EDIT</Ид>
				<Значение>Изменить элемент</Значение>
			</БитриксПодпись>
			<БитриксПодпись>
				<Ид>ELEMENT_DELETE</Ид>
				<Значение>Удалить элемент</Значение>
			</БитриксПодпись>
			<БитриксПодпись>
				<Ид>SECTION_NAME</Ид>
				<Значение>Раздел</Значение>
			</БитриксПодпись>
			<БитриксПодпись>
				<Ид>SECTIONS_NAME</Ид>
				<Значение>Разделы</Значение>
			</БитриксПодпись>
			<БитриксПодпись>
				<Ид>SECTION_ADD</Ид>
				<Значение>Добавить раздел</Значение>
			</БитриксПодпись>
			<БитриксПодпись>
				<Ид>SECTION_EDIT</Ид>
				<Значение>Изменить раздел</Значение>
			</БитриксПодпись>
			<БитриксПодпись>
				<Ид>SECTION_DELETE</Ид>
				<Значение>Удалить раздел</Значение>
			</БитриксПодпись>
		</БитриксПодписи>
		<НаследуемыеШаблоны>
			<Шаблон>
				<Ид>SECTION_META_TITLE</Ид>
				<Значение>{=this.property.browser_title}</Значение>
			</Шаблон>
			<Шаблон>
				<Ид>SECTION_META_KEYWORDS</Ид>
				<Значение>{=this.property.keywords}</Значение>
			</Шаблон>
			<Шаблон>
				<Ид>SECTION_META_DESCRIPTION</Ид>
				<Значение>{=this.property.meta_description}</Значение>
			</Шаблон>
			<Шаблон>
				<Ид>SECTION_PAGE_TITLE</Ид>
				<Значение>{=this.property.section_title}</Значение>
			</Шаблон>
			<Шаблон>
				<Ид>ELEMENT_META_TITLE</Ид>
				<Значение>{=this.property.TITLE}</Значение>
			</Шаблон>
			<Шаблон>
				<Ид>ELEMENT_META_KEYWORDS</Ид>
				<Значение>{=this.property.KEYWORDS}</Значение>
			</Шаблон>
			<Шаблон>
				<Ид>ELEMENT_META_DESCRIPTION</Ид>
				<Значение>{=this.property.META_DESCRIPTION}</Значение>
			</Шаблон>
			<Шаблон>
				<Ид>ELEMENT_PAGE_TITLE</Ид>
				<Значение>{=this.property.PRODUCT_TITLE}</Значение>
			</Шаблон>
